{
  "name": "fraga-lanches",
  "version": "2.0.0",
  "description": "Sistema de pedidos para hamburgueria artesanal Fraga Lanches - Microservices Architecture",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "realtime": "node src/realtime-server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run realtime\"",
    "db:init": "node src/database/init.js",
    "db:migrate": "node src/database/migrate.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "services:install": "cd services/auth && npm install && cd ../menu && npm install && cd ../order && npm install && cd ../client && npm install && cd ../delivery && npm install && cd ../notification && npm install && cd ../report && npm install && cd ../review && npm install && cd ../payment && npm install && cd ../api-gateway && npm install && cd ../frontend && npm install",
    "services:start": "concurrently -c concurrently.config.js",
    "services:dev": "concurrently -c concurrently.config.js --kill-others-on-fail",
    "gateway:start": "node services/api-gateway/src/index.js",
    "gateway:dev": "node --watch services/api-gateway/src/index.js",
    "shared:install": "cd shared && npm install"
  },
  "keywords": [
    "restaurant",
    "orders",
    "hamburgueria",
    "delivery",
    "microservices"
  ],
  "author": "Fraga Lanches",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "^5.17.0",
    "argon2": "^0.40.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.3",
    "web-push": "^3.6.7",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^25.1.0",
    "supertest": "^6.3.3"
  }
}
