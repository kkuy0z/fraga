# Fraga Lanches - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT Secret (generate a strong random string)
JWT_SECRET=fraga-lanches-dev-secret-key-2026-change-in-production

# Database
# Uses SQLite by default, file will be created automatically
# For production, consider using PostgreSQL with a different connection module

# Push Notifications (VAPID Keys)
# Generate with: node generate-vapid-keys.js
VAPID_PUBLIC_KEY=BGrZGkL-aE3MfY03Er07BXXUFqs1IcCsqVIva0WHFiVQ1UIohBVDXvsfI5psMJKKojWDJulVOcB1BzUy_iGwv78
