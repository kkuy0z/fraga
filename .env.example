# Fraga Lanches - Environment Variables
# Copy this file to .env and adjust values as needed

# Database Configuration
DB_ROOT_PASSWORD=fraga_root_password_change_in_production
DB_NAME=fraga_lanches
DB_USER=fraga_user
DB_PASSWORD=fraga_password_change_in_production

# RabbitMQ Configuration
RABBITMQ_USER=fraga
RABBITMQ_PASSWORD=fraga_password_change_in_production
RABBITMQ_VHOST=fraga

# JWT Configuration
JWT_SECRET=fraga_jwt_secret_change_in_production_use_strong_random_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# VAPID Keys for Push Notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=

# Mercado Pago Configuration
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=