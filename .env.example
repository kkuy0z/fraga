# Fraga Lanches - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development

# Real-time Server (WebSocket/SSE)
WS_PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ============================================
# JWT & SECURITY
# ============================================
# JWT Secret (generate a strong random string, min 32 chars for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Expiration
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# DATABASE
# ============================================
# SQLite database path (relative to project root)
DB_PATH=fraga_lanches.db

# ============================================
# PUSH NOTIFICATIONS (VAPID Keys)
# ============================================
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@fragalanches.com

# ============================================
# PAYMENT GATEWAY (Mercado Pago)
# ============================================
# Get from: https://www.mercadopago.com/developers/panel
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# ============================================
# EMAIL (for order confirmations, etc.)
# ============================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Fraga Lanches <noreply@fragalanches.com>

# ============================================
# WHATSAPP BUSINESS API (optional)
# ============================================
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ============================================
# MICROSERVICES PORTS (auto-calculated from PORT)
# ============================================
# Auth Service: PORT (3000)
# Menu Service: PORT + 1 (3001)
# Order Service: PORT + 2 (3002)
# Client Service: PORT + 3 (3003)
# Delivery Service: PORT + 4 (3004)
# Notification Service: PORT + 5 (3005) + WS_PORT (3001)
# Report Service: PORT + 6 (3006)
# Review Service: PORT + 7 (3007)
# Payment Service: PORT + 8 (3008)
# API Gateway: PORT - 1 (2999)
# Frontend Service: PORT + 9 (3009)

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# DEVELOPMENT OVERRIDES
# ============================================
# Set to 'true' to disable rate limiting in development
DISABLE_RATE_LIMIT=false

# Set to 'true' to enable debug SQL queries
DEBUG_SQL=false