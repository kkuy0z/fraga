# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Segurança - JWT
# IMPORTANTE: Em produção, use uma chave forte e única (mínimo 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=sua-chave-secreta-super-forte-aqui-mude-em-producao

# Banco de Dados
DB_PATH=./fraga_lanches.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10

# Configurações de E-mail (futuro)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Configurações de Upload (futuro)
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE=5242880