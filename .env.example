# Fraga Lanches - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT Secret (generate a strong random string, min 32 chars for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10

# Database
# Uses SQLite by default, file will be created automatically
# For production, consider using PostgreSQL with a different connection module

# Push Notifications (VAPID Keys)
# Generate with: node generate-vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@fragalanches.com

# Payment Gateway (Mercado Pago example)
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_PUBLIC_KEY=
# MERCADO_PAGO_WEBHOOK_SECRET=

# Email (for order confirmations, etc.)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Fraga Lanches <noreply@fragalanches.com>

# WhatsApp Business API (optional)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=