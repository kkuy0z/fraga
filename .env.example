# =============================================
# Fraga Lanches - Environment Configuration
# Copy this file to .env and adjust values as needed
# =============================================

# ---------------------------------------------
# Environment
# ---------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
SQL_ECHO=false

# ---------------------------------------------
# Database (MariaDB/MySQL)
# ---------------------------------------------
# Format: mysql+asyncmy://user:password@host:port/database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fraga_lanches
DB_USER=fraga_user
DB_PASSWORD=fraga_password
DB_ROOT_PASSWORD=fraga_root_password

# Constructed DATABASE_URL (used by services)
DATABASE_URL=mysql+asyncmy://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ---------------------------------------------
# RabbitMQ Message Broker
# ---------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=fraga
RABBITMQ_PASSWORD=fraga_password
RABBITMQ_VHOST=fraga

# Constructed RABBITMQ_URL (used by services)
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# RabbitMQ Management UI (if using Docker for RabbitMQ only)
RABBITMQ_MANAGEMENT_PORT=15672

# ---------------------------------------------
# JWT Authentication
# ---------------------------------------------
JWT_SECRET=fraga_jwt_secret_change_in_production_use_strong_random_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------
# CORS
# ---------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------
# Service Ports (each service runs on its own port locally)
# ---------------------------------------------
AUTH_SERVICE_PORT=8001
CATALOGO_SERVICE_PORT=8002
PEDIDOS_SERVICE_PORT=8003
COZINHA_SERVICE_PORT=8004
ENTREGAS_SERVICE_PORT=8005
NOTIFICACOES_SERVICE_PORT=8006
AVALIACOES_SERVICE_PORT=8007
PAGAMENTOS_SERVICE_PORT=8008
RELATORIOS_SERVICE_PORT=8009
GATEWAY_SERVICE_PORT=8000

# Service URLs for Gateway (localhost since no Docker network)
AUTH_SERVICE_URL=http://localhost:${AUTH_SERVICE_PORT}
CATALOGO_SERVICE_URL=http://localhost:${CATALOGO_SERVICE_PORT}
PEDIDOS_SERVICE_URL=http://localhost:${PEDIDOS_SERVICE_PORT}
COZINHA_SERVICE_URL=http://localhost:${COZINHA_SERVICE_PORT}
ENTREGAS_SERVICE_URL=http://localhost:${ENTREGAS_SERVICE_PORT}
NOTIFICACOES_SERVICE_URL=http://localhost:${NOTIFICACOES_SERVICE_PORT}
AVALIACOES_SERVICE_URL=http://localhost:${AVALIACOES_SERVICE_PORT}
PAGAMENTOS_SERVICE_URL=http://localhost:${PAGAMENTOS_SERVICE_PORT}
RELATORIOS_SERVICE_URL=http://localhost:${RELATORIOS_SERVICE_PORT}

# ---------------------------------------------
# Frontend
# ---------------------------------------------
FRONTEND_PORT=8080
FRONTEND_URL=http://localhost:${FRONTEND_PORT}

# ---------------------------------------------
# Mercado Pago (Payments)
# ---------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# ---------------------------------------------
# Web Push Notifications (VAPID Keys)
# Generate with: python -c "from pywebpush import generate_vapid_keys; print(generate_vapid_keys())"
# ---------------------------------------------
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=