# Fraga Lanches - Environment Variables
# Copy this file to .env and fill in your values

# =============================================
# DATABASE
# =============================================
MYSQL_ROOT_PASSWORD=fraga_root_2026
MYSQL_DATABASE=fraga_lanches
MYSQL_USER=fraga_user
MYSQL_PASSWORD=fraga_pass_2026

# =============================================
# RABBITMQ
# =============================================
RABBITMQ_USER=fraga_user
RABBITMQ_PASSWORD=fraga_pass_2026

# =============================================
# JWT AUTHENTICATION
# =============================================
JWT_SECRET=fraga-super-secret-jwt-key-2026-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# =============================================
# ARGON2ID PASSWORD HASHING
# =============================================
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# =============================================
# WEB PUSH (VAPID Keys)
# Generate with: python -c "from pywebpush import generate_vapid_keys; print(generate_vapid_keys())"
# =============================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@fragalanches.com

# =============================================
# MERCADO PAGO (Payment Gateway)
# Get credentials from: https://www.mercadopago.com.br/developers/panel
# =============================================
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# =============================================
# APPLICATION SETTINGS
# =============================================
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=*
BASE_URL=http://localhost:8000

# =============================================
# SERVICE URLS (for inter-service communication)
# These are set automatically by docker-compose
# =============================================
# AUTH_SERVICE_URL=http://ms-auth:8000
# CATALOGO_SERVICE_URL=http://ms-catalogo:8000
# PEDIDOS_SERVICE_URL=http://ms-pedidos:8000
# COZINHA_SERVICE_URL=http://ms-cozinha:8000
# ENTREGAS_SERVICE_URL=http://ms-entregas:8000
# NOTIFICACOES_SERVICE_URL=http://ms-notificacoes:8000
# AVALIACOES_SERVICE_URL=http://ms-avaliacoes:8000
# PAGAMENTOS_SERVICE_URL=http://ms-pagamentos:8000
# RELATORIOS_SERVICE_URL=http://ms-relatorios:8000